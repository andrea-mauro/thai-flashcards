{
  "name": "thai-flashcards",
  "version": "1.0.0",
  "description": "A lightweight, standalone web application for learning Thai vocabulary and phrases. It features category filtering, progress tracking (learned vs. hard cards), daily streaks, and text-to-speech audio.",
  "main": "app.js",
  "scripts": {
    "start": "npm run serve",
    "serve": "http-server docs -p 5566",
    "test": "start-server-and-test serve http://localhost:5566 cypress:run",
    "test:open": "start-server-and-test serve http://localhost:5566 cypress:open",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "cypress": "^15.14.0",
    "http-server": "^14.1.1",
    "start-server-and-test": "^3.0.2"
  }
}
